{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @terazi/core db:generate",
    "watchPatterns": ["apps/worker/**", "packages/core/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @terazi/worker run:tcmb",
    "cronSchedule": "30 15 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
